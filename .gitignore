# ============================================================================
# ReTrac Security & Production .gitignore
# ============================================================================

# Environment variables (NEVER commit actual credentials)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
coverage/
.next/
out/

# Logs and runtime diagnostics
logs/
*.log
npm-debug.log*

# Local Database Files (SQLite runtime)
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
backend/data/
data/

# Temporary and upload storage
storage/
uploads/
private/
tmp/
temp/

# Operating System artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Certificates, Keys, and Service Accounts
*.pem
*.key
*.p12
*.pfx
*.cert
credentials.json
service-account.json
