# ============================================================================
# ReTrac MVP — Environment Variables Template (.env.example)
# DOMINION 2026 — Track 05: Rehabilitation & Reintegration
# ============================================================================
# NOTE: This file contains ONLY placeholder values.
# Copy this file to .env and replace with your actual environment configuration.
# Never commit real credentials, API keys, or production passwords to GitHub.
# ============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://username:password@localhost:5432/retrac
FRONTEND_URL=http://localhost:5173

# Authentication Security
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
CRON_SECRET=CHANGE_ME_TO_A_CRON_SECRET

# Demo Mode Configuration
DEMO_MODE=true

# SMS Provider Configuration ('demo' or 'africastalking')
SMS_PROVIDER=demo
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=RETRAC

# AI Risk Analyzer ('demo' or 'openai')
AI_PROVIDER=demo
OPENAI_API_KEY=

# Mobile Money Provider ('demo', 'mtn', or 'airtel')
PAYMENT_PROVIDER=demo
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_PRIMARY_KEY=
AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
