# ReTrac MVP Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/retrac_db

# Authentication
JWT_SECRET=retrac_jwt_super_secret_session_key_2026_dominion
JWT_EXPIRES_IN=7d

# Feature Flags & Demo Mode
DEMO_MODE=true
CRON_SECRET=retrac_internal_cron_secret_key_2026

# External Providers Configuration
# SMS Provider: 'demo' or 'africastalking'
SMS_PROVIDER=demo
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=atsk_sample_key_demo_only
AFRICASTALKING_SENDER_ID=RETRAC

# AI Risk Analyzer: 'demo' or 'openai'
AI_PROVIDER=demo
OPENAI_API_KEY=sk-demo-key-not-required-for-demo-mode

# Mobile Money Provider: 'demo', 'mtn', or 'airtel'
PAYMENT_PROVIDER=demo
MTN_MOMO_API_KEY=momo_demo_key
MTN_MOMO_API_SECRET=momo_demo_secret
MTN_MOMO_PRIMARY_KEY=momo_sub_key
AIRTEL_MONEY_CLIENT_ID=airtel_demo_id
AIRTEL_MONEY_CLIENT_SECRET=airtel_demo_secret
